  "dependencies": {
    "@sailfish-studio/jszip": "workspace:*"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^14.0.0",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  }
}
