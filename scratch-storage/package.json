{
  "name": "@sailfish-studio/scratch-storage",
  "version": "2.0.0",
  "description": "Load and store project and asset files for Scratch 3.0",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/Sailfish-Studio/scratch-storage#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sailfish-Studio/scratch-storage.git"
  },
  "main": "./src/index.js",
  "browser": "./src/index.js",
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "bun run ../../scripts/build.js scratch-storage",
    "coverage": "tap ./test/{unit,integration}/*.js --coverage --coverage-report=lcov",
    "test": "npm run test:lint && jest \"test[\\\\/](unit|integration)\"",
    "test:clearCache": "jest --clearCache",
    "test:lint": "eslint .",
    "test:integration": "jest \"test[\\\\/]integration\"",
    "test:unit": "jest \"test[\\\\/]unit\"",
    "watch": "bun run ../../scripts/build.js --watch scratch-storage"
  },
  "tap": {
    "check-coverage": false
  },
  "dependencies": {
    "@sailfish-studio/nanolog": "workspace:*",
    "base64-js": "1.3.0",
    "cross-fetch": "3.1.5",
    "js-md5": "0.7.3"
  },
  "devDependencies": {}
}
