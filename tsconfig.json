{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@sailfish/core": ["./packages/core/src"],
      "@sailfish/render": ["./packages/render/src"],
      "@sailfish/ui": ["./packages/ui/src"],
      "@sailfish/blocks-ui": ["./packages/blocks-ui/src"],
      "@sailfish/shared": ["./packages/shared/src"],
      "@sailfish/paper": ["./packages/paper/src"]
    },
    "types": ["node"]
  },
  "include": ["packages/*/src/**/*", "apps/*/src/**/*"],
  "exclude": ["node_modules", "**/dist/**", "**/build/**"]
}
