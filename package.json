{
  "name": "sailfish-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Sailfish Studio - A Scratch-compatible creative coding platform",
  "scripts": {
    "dev": "pnpm --filter @sailfish/web dev",
    "build": "pnpm run --filter @sailfish/blocks-ui build && pnpm --filter @sailfish/web build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf packages/*/dist apps/*/build"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
