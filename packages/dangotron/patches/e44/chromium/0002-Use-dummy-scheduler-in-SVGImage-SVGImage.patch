From bdcc619844ac9bd53f289f8675e52dd2f8b9a82c Mon Sep 17 00:00:00 2001
From: Thomas Weber <muffin@muffin.ink>
Date: Sun, 5 Jul 2026 12:04:24 -0500
Subject: Use dummy scheduler in SVGImage::SVGImage

---
 .../blink/renderer/core/svg/graphics/svg_image.cc   | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/third_party/blink/renderer/core/svg/graphics/svg_image.cc b/third_party/blink/renderer/core/svg/graphics/svg_image.cc
index 01bf2eda157ac..68034fcde7d0e 100644
--- a/third_party/blink/renderer/core/svg/graphics/svg_image.cc
+++ b/third_party/blink/renderer/core/svg/graphics/svg_image.cc
@@ -68,6 +68,9 @@
 #include "ui/gfx/geometry/rect_conversions.h"
 #include "ui/gfx/geometry/size_conversions.h"
 #include "ui/gfx/geometry/skia_conversions.h"
+// Dangotron: new imports
+#include "third_party/blink/renderer/platform/scheduler/public/dummy_schedulers.h"
+#include "v8/include/v8-isolate.h"
 
 namespace blink {
 
@@ -97,10 +100,12 @@ SVGImage::SVGImage(ImageObserver* observer, bool is_multipart)
       // smaller granularity. There is an active effort to mitigate
       // this which is called "Memory Cache Per Context"
       // (https://crbug.com/1127971).
-      agent_group_scheduler_(Thread::MainThread()
-                                 ->Scheduler()
-                                 ->ToMainThreadScheduler()
-                                 ->CreateAgentGroupScheduler()),
+      // Dangotron: Use a dummy scheduler instead of the real scheduler.
+      // This avoids registering it in the renderer-wide scheduler, which
+      // causes performance issues due to several O(n) tasks. In projects
+      // with a lot of SVGs, `n` can become quite large.
+      agent_group_scheduler_(scheduler::CreateDummyAgentGroupScheduler(
+          v8::Isolate::GetCurrent())),
       has_pending_timeline_rewind_(false) {}
 
 SVGImage::~SVGImage() {
-- 
