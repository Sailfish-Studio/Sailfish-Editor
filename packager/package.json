{
  "name": "@sailfish-studio/packager",
  "version": "3.13.0",
  "description": "Converts Scratch projects into HTML files, zip archives, or executable programs for Windows, macOS, and Linux.",
  "main": "dist/packager.js",
  "scripts": {
    "start": "bun run ../../scripts/dev.js",
    "clean": "rm -rf dist",
    "build": "bun run ../../scripts/build.js packager",
    "build-prod": "cross-env NODE_ENV=production bun run ../../scripts/build.js packager",
    "watch": "bun run ../../scripts/build.js --watch packager",
    "build-standalone": "cross-env STANDALONE=1 bun run ../../scripts/build.js packager && node src/build/generate-standalone.js",
    "build-standalone-prod": "cross-env NODE_ENV=production bun run ../../scripts/build.js packager && node src/build/generate-standalone.js",
    "build-node": "cross-env BUILD_MODE=node bun run ../../scripts/build.js packager",
    "build-node-prod": "cross-env NODE_ENV=production bun run ../../scripts/build.js packager",
    "test": "jest",
    "prepublishOnly": "npm run test && npm run build-node-prod && node src/build/nodejs/update-readme.js node",
    "postpublish": "node src/build/nodejs/update-readme.js restore"
  },
  "author": "GarboMuffin",
  "homepage": "https://github.com/TurboWarp/packager#readme",
  "keywords": [
    "scratch",
    "packager"
  ],
  "bugs": {
    "url": "https://github.com/TurboWarp/packager/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TurboWarp/packager.git"
  },
  "license": "MPL-2.0",
  "dependencies": {
    "@fiahfy/icns": "^0.0.7",
    "@turbowarp/json": "^0.1.1",
    "@sailfish-studio/jszip": "workspace:*",
    "@turbowarp/sbdl": "^7.0.0",
    "cross-fetch": "^4.1.0",
    "sha.js": "^2.4.11"
  },
  "devDependencies": {
    "@babel/core": "^7.16.5",
    "@babel/preset-env": "^7.16.5",
    "@sailfish-studio/scratch-storage": "workspace:*",
    "@sailfish-studio/scratch-svg-renderer": "workspace:*",
    "babel-jest": "^27.4.5",
    "babel-loader": "^8.2.3",
    "copy-webpack-plugin": "^6.4.1",
    "cross-env": "^10.1.0",
    "css-loader": "^5.2.7",
    "fastestsmallesttextencoderdecoder": "^1.0.22",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^4.5.2",
    "jest": "^27.4.5",
    "rimraf": "^2.7.1",
    "scratch-audio": "workspace:*",
    "scratch-render": "workspace:*",
    "scratch-vm": "workspace:*",
    "style-loader": "^2.0.0",
    "svelte": "^3.44.3",
    "svelte-loader": "^3.1.2",
    "url-loader": "^4.1.1",
    "webpack": "4.47.0",
    "webpack-bundle-analyzer": "^4.5.0",
    "webpack-cli": "^4.9.1",
    "webpack-dev-server": "^3.11.3",
    "worker-loader": "^2.0.0"
  },
  "overrides": {
    "webpack@4.47.0": {
      "terser-webpack-plugin": "^4.2.3"
    }
  }
}
